# MarkMind 환경 변수 예시 — 이 파일을 .env.local로 복사해 실제 값을 채워 넣으세요.
#   cp .env.example .env.local
# 실제 비밀 값은 절대 커밋하지 마세요.

# Firebase Admin SDK 서비스 계정 JSON 전체를 한 줄 문자열로 (서버 전용)
# 사용처: lib/firebase-admin.ts
FIREBASE_SERVICE_ACCOUNT=

# Web Push VAPID 키 쌍 (npx web-push generate-vapid-keys 로 생성)
# 공개 키는 클라이언트 구독에, 비밀 키는 서버 발송에 사용됩니다.
# 사용처: lib/firebase-messaging.ts, lib/push.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cron 엔드포인트(/api/cron/check-updates) 보호용 Bearer 시크릿
# 사용처: app/api/cron/check-updates/route.ts
CRON_SECRET=

# 문의 폼(web3forms) access key — 설계상 공개되는 클라이언트 키입니다.
# 미설정 시 코드에 내장된 기본 키로 동작합니다.
# 사용처: components/contact-form.tsx
NEXT_PUBLIC_WEB3FORMS_KEY=

# (선택) AI 요약·분류 — 비워 두면 규칙 기반 분류만 사용합니다.
# 사용처: lib/ai-analyze.ts, lib/ai-quota.ts
ANTHROPIC_API_KEY=
# 사용할 모델 (기본 claude-opus-5-5). 비용을 크게 줄이려면 claude-haiku-5-5
ANTHROPIC_MODEL=
# 사용자 1명이 하루에 AI 분석·번역을 쓸 수 있는 횟수 (기본 100). 넘으면 그날은 규칙 기반으로 처리
AI_DAILY_LIMIT=

# (선택) 북마크 설명 번역(화면 언어로 표시)을 Google Gemini 무료 등급으로 — 있으면 Claude 대신 사용
# 무료 등급은 분·일 요청 수 제한이 있고, 보낸 내용을 Google이 서비스 개선에 쓸 수 있습니다.
# 사용처: lib/gemini-translate.ts
GEMINI_API_KEY=
# 사용할 모델 (기본 gemini-flash-lite-latest — Google이 최신 Flash-Lite로 자동 연결하는 별칭)
GEMINI_MODEL=

# 참고: Firebase 클라이언트 설정(apiKey, projectId 등)은 환경 변수가 아니라
# lib/firebase.ts에 직접 작성되어 있습니다.
